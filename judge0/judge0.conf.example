################################################################################
# Judge0 Configuration File — baseado no template oficial do projeto Judge0.
#
# NÃO EDITE ESTE ARQUIVO PARA RODAR O SISTEMA. Ele é só o template versionado
# no git. Rode `./gerar-conf.sh` pra gerar um `judge0.conf` real (git-ignorado)
# com senhas aleatórias geradas na hora. Os valores abaixo com "SUBSTITUA_"
# são preenchidos automaticamente por esse script.
#
# Comentários originais mantidos em inglês (documentação oficial do Judge0).
# Anotações nossas em português, marcadas com "# NOTA:".
################################################################################


################################################################################
# Judge0 Server Configuration
################################################################################
JUDGE0_TELEMETRY_ENABLE=false
RESTART_MAX_TRIES=
MAINTENANCE_MODE=
MAINTENANCE_MESSAGE=

# Se true, permite submissão síncrona (wait=true). Nosso backend usa modo
# assíncrono com polling (ver decisões de arquitetura), então isso não importa
# muito pra nós, mas deixamos habilitado pra não travar testes manuais via curl.
ENABLE_WAIT_RESULT=true

ENABLE_COMPILER_OPTIONS=true
ALLOWED_LANGUAGES_FOR_COMPILER_OPTIONS=
ENABLE_COMMAND_LINE_ARGUMENTS=true
ENABLE_SUBMISSION_DELETE=false
ENABLE_BATCHED_SUBMISSIONS=true
MAX_SUBMISSION_BATCH_SIZE=20
ENABLE_CALLBACKS=true
CALLBACKS_MAX_TRIES=3
CALLBACKS_TIMEOUT=5
ENABLE_ADDITIONAL_FILES=true
SUBMISSION_CACHE_DURATION=1
USE_DOCS_AS_HOMEPAGE=false
DISABLE_IMPLICIT_BASE64_ENCODING=false


################################################################################
# Judge0 Workers Configuration
################################################################################
INTERVAL=0.1

# NOTA: default oficial é 2*nproc. Isso aqui vai rodar num notebook (4
# núcleos) ao lado do Electron+Monaco e do painel — 2 workers é o suficiente
# pra demo com poucas estações e não trava o resto da máquina. Numa VPS
# dedicada de verdade, subir esse número.
COUNT=2

MAX_QUEUE_SIZE=100


################################################################################
# Judge0 Server Access Configuration
################################################################################
ALLOW_ORIGIN=
DISALLOW_ORIGIN=
ALLOW_IP=
DISALLOW_IP=


################################################################################
# Judge0 Authentication Configuration
################################################################################
AUTHN_HEADER=
AUTHN_TOKEN=


################################################################################
# Judge0 Authorization Configuration
################################################################################
AUTHZ_HEADER=
AUTHZ_TOKEN=


################################################################################
# Redis Configuration
################################################################################
REDIS_HOST=redis
REDIS_PORT=
# NOTA: gerado por gerar-conf.sh (openssl rand -hex 24)
REDIS_PASSWORD=SUBSTITUA_SENHA_REDIS
RESQUE_NAMESPACE=


################################################################################
# PostgreSQL Configuration
################################################################################
POSTGRES_HOST=db
POSTGRES_PORT=
POSTGRES_DB=judge0
POSTGRES_USER=judge0
# NOTA: gerado por gerar-conf.sh (openssl rand -hex 24)
POSTGRES_PASSWORD=SUBSTITUA_SENHA_POSTGRES


################################################################################
# Submission Configuration (repassado para o `isolate`)
################################################################################
CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=15
CPU_EXTRA_TIME=1
MAX_CPU_EXTRA_TIME=5
WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=20
MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=512000
STACK_LIMIT=64000
MAX_STACK_LIMIT=128000
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=120
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=true
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=true
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=4096
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=20
REDIRECT_STDERR_TO_STDOUT=false
MAX_EXTRACT_SIZE=10240

# NOTA: mantido false — nenhuma submissão de aluno deve conseguir fazer
# chamada de rede. Isso não é só limite de recurso, é controle de trapaça
# (evita, por exemplo, um script que baixa a resposta de algum lugar).
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false


################################################################################
# Rails Configuration
################################################################################
RAILS_ENV=production
RAILS_MAX_THREADS=
RAILS_SERVER_PROCESSES=
# NOTA: gerado por gerar-conf.sh (openssl rand -hex 64)
SECRET_KEY_BASE=SUBSTITUA_SECRET_KEY_BASE
