# Copie para .env (git-ignorado) e ajuste se necessário.

PORT=3000
NODE_ENV=development

# Firebase Realtime Database
# Em desenvolvimento local, aponte para o Firebase Emulator Suite — roda 100%
# local, sem depender de rede nem de projeto Firebase real:
#   npx firebase-tools emulators:start --only database
# O Admin SDK detecta e usa o emulador automaticamente quando esta variável
# está definida, mesmo com uma FIREBASE_DATABASE_URL "de produção" abaixo.
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_PROJECT_ID=sistema-provas-dev
FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=sistema-provas-dev

# Produção: caminho para o JSON da service account (deixe em branco localmente).
# GOOGLE_APPLICATION_CREDENTIALS=
