# Copie para .env.local (git-ignorado) e ajuste se necessário.

# Backend (Fase 2) — usado pelo botão "Desbloquear estação".
VITE_API_BASE_URL=http://localhost:3000

# Firebase Realtime Database — em desenvolvimento local aponta para o
# Firebase Emulator Suite (ver backend/README.md), mesmo projeto/namespace
# usado pelo backend. apiKey pode ser qualquer valor não-vazio: o emulador
# não valida credenciais.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=sistema-provas-dev
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=sistema-provas-dev
VITE_FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_DATABASE_EMULATOR_PORT=9000
